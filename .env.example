APP_NAME="Nexo - Dulce Rincón"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

# SQLite guarda los datos en database/database.sqlite.
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
LOG_LEVEL=warning
MAIL_MAILER=log

# Solo se usa al ejecutar el seeder de demostración en entorno local.
DEMO_PASSWORD="NexoDemo2026!"
